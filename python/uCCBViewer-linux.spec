# -*- mode: python ; coding: utf-8 -*-
# Linux counterpart of uCCBViewer.spec. Uses SPECPATH-relative paths so it is
# portable, and drops the Windows .ico icon (PyInstaller only embeds icons on
# Windows/macOS).
import datetime
import os

from PyInstaller.utils.hooks import collect_submodules

# Stamp the build date/time into a generated module so the GUI can show it in
# its title bar.  Regenerated on every build (gitignored).
_build_time = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
with open(os.path.join(SPECPATH, "uccbviewer", "_build_info.py"),
          "w", encoding="utf-8") as _f:
    _f.write("# Auto-generated by uCCBViewer.spec at build time -- do not edit.\n")
    _f.write('BUILD_TIME = "%s"\n' % _build_time)

hiddenimports = []
hiddenimports += collect_submodules('udsoncan')
hiddenimports += collect_submodules('serial')

# Same rationale as the Windows spec: keep the unused heavy python-can backends
# (numpy/scipy/etc.) out of the build.
excludes = [
    'can',                       # python-can (unused; pulls the rest in)
    'numpy', 'scipy',            # only reached via can.io.{blf,mf4}
    'wrapt', 'yaml',             # only reached via can.*
    'matplotlib', 'pandas', 'PIL',
    'pytest', 'IPython',
    'tkinter.test', 'test', 'unittest',
]


a = Analysis(
    [os.path.join(SPECPATH, 'viewer_entry.py')],
    pathex=[SPECPATH],
    binaries=[],
    datas=[(os.path.join(SPECPATH, 'uccbviewer', 'icons'), 'uccbviewer/icons')],
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
    optimize=2,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='uCCBViewer',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
